# toolchain-vibe — the pinned uv/Python substrate the headless `vibe` CLI
# depends on (ISI-6158 C3). The CLI ships on PyPI as `mistral-vibe`
# (versions 0.0.0 then 1.0.0+; there is no `vibe==0.3.0` anywhere), so the
# buildable pin is mistral-vibe==2.9.6 — the exact substrate the ISI-6211
# live-validation lane settled a real vibe task on. NOTE: the engine still
# advertises CLIVersion py-v0.3.0 (agentruntime/vibe.go, ADR-017);
# realigning that seam with the shipped substrate is follow-up work.
# The codex toolchain image is an optional follow-up (plan decision D2).
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git curl ripgrep \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Pinned install; the layer cache keeps rebuilds deterministic.
RUN uv tool install --python-preference only-system mistral-vibe==2.9.6 \
 && uv tool update-shell || true

ENV PATH="/root/.local/bin:${PATH}" \
    VIBE_NONINTERACTIVE=1

# Smoke: the pinned CLI must answer --version.
RUN vibe --version

WORKDIR /workspace
ENTRYPOINT ["vibe"]
