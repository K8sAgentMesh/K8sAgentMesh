#!/bin/sh
# mesh-codex-exec — TEST-ONLY reimplementation of the k8squad D4 stdin
# wrapper contract that agentruntime's codex engine execs
# (agentruntime/codex.go): combine the spilled system-context file
# (KSQUAD_SYSTEM_CONTEXT_FILE) with KSQUAD_INPUT, blank-line separated —
# agentruntime.EnvelopePrompt semantics — and pipe the envelope into
# `codex exec -` on stdin, passing all argv through untouched.
#
# It also selects the BYO provider the runtime renders into
# $CODEX_HOME/config.toml ([model_providers.ksquad-byo], wire_api="chat")
# so codex speaks chat-completions to the lane's Ollama instead of the
# Responses API. Test-lane fixture only — the real wrapper belongs in this
# repo eventually (see test/live/README.md gap 3).
set -eu

ctx=""
if [ -n "${KSQUAD_SYSTEM_CONTEXT_FILE:-}" ] && [ -f "${KSQUAD_SYSTEM_CONTEXT_FILE}" ]; then
  ctx="$(cat "${KSQUAD_SYSTEM_CONTEXT_FILE}")"
fi
input="${KSQUAD_INPUT:-}"

# Select the BYO provider when the runtime rendered its config (idempotent).
cfg="${CODEX_HOME:-}/config.toml"
if [ -f "$cfg" ] && ! grep -q '^model_provider' "$cfg"; then
  printf '\nmodel_provider = "ksquad-byo"\n' >> "$cfg"
fi

# buildEnvelope: system context precedes the instruction; either may be empty.
if [ -n "$ctx" ] && [ -n "$input" ]; then
  printf '%s\n\n%s\n' "$ctx" "$input"
elif [ -n "$ctx" ]; then
  printf '%s\n' "$ctx"
elif [ -n "$input" ]; then
  printf '%s\n' "$input"
fi | exec codex exec - "$@"
